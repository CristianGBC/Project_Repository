# Host B address used by the coordinator running on Host A.
# Copy this file to .env and update the address if the local network changes.
NODE_BIO_URL=http://192.168.1.23:8001
NODE_PHY_URL=http://192.168.1.23:8002
NODE_MATH_URL=http://192.168.1.23:8003
NODE_CHEM_URL=http://192.168.1.23:8004
NODE_EARTH_URL=http://192.168.1.23:8005
NODE_AGRO_URL=http://192.168.1.23:8006

# Increase carefully only when measured Wi-Fi latency requires it.
NODE_REQUEST_TIMEOUT_SECONDS=2.0

# Document transfer settings shared by coordinator and storage nodes.
DOCUMENT_TRANSFER_TIMEOUT_SECONDS=30.0
MAX_UPLOAD_SIZE_MB=10
# Supported values: 1 for comparison experiments, 3 for synchronous replication.
REPLICATION_FACTOR=3

# Independent storage-node health monitor.
HEALTH_CHECK_INTERVAL_SECONDS=5
HEALTH_CHECK_TIMEOUT_SECONDS=2
HEALTH_FAILURE_THRESHOLD=3
HEALTH_RECOVERY_THRESHOLD=2

# Independent replica-repair service. Use a long random token outside local
# development and configure the same value on repair and storage services.
REPAIR_ENABLED=true
REPAIR_INTERVAL_SECONDS=10
REPAIR_DOWN_GRACE_SECONDS=60
REPAIR_MAX_CONCURRENT_JOBS=2
REPAIR_TRANSFER_TIMEOUT_SECONDS=120
REPAIR_RETRY_BACKOFF_SECONDS=30
REPAIR_EXCESS_CLEANUP_ENABLED=true
REPAIR_INTERNAL_TOKEN=CHANGE_ME_TO_A_LONG_RANDOM_VALUE
STORAGE_INTERNAL_TOKEN=CHANGE_ME_TO_A_DIFFERENT_LONG_RANDOM_VALUE

# Incomplete-upload reconciliation. It shares the authenticated internal
# storage transfer token with replica repair.
RECONCILIATION_ENABLED=true
RECONCILIATION_INTERVAL_SECONDS=15
RECONCILIATION_RETRY_BACKOFF_SECONDS=30
RECONCILIATION_MAX_ATTEMPTS=10
RECONCILIATION_MAX_CONCURRENT_JOBS=2
RECONCILIATION_TRANSFER_TIMEOUT_SECONDS=120

# PostgreSQL runs independently on Host B. Replace placeholders locally only;
# never commit the resulting .env file.
DATABASE_URL=postgresql+psycopg://yachayrepo_app:CHANGE_ME@POSTGRES_HOST:5432/yachayrepo_db

# Non-login technical identity retained only for legacy/import operations. The
# default hash is a disabled-login marker, not a plaintext password.
TECHNICAL_USER_ID=7d14ef5d-3c61-4ac8-90b5-2bd3f0aa0431
TECHNICAL_USER_EMAIL=development-operations@yachayrepo.invalid
TECHNICAL_USER_PASSWORD_HASH=!authentication-disabled!

# Academic-user authentication. Generate a random secret of at least 32
# characters. HTTPS is mandatory outside local development.
AUTH_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_JWT_SECRET
AUTH_JWT_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_JWT_ISSUER=yachayrepo
AUTH_JWT_AUDIENCE=yachayrepo-api
# Optional comma-separated institutional domains; empty accepts valid domains.
AUTH_ALLOWED_EMAIL_DOMAINS=
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=300
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Used only with: python -m backend.auth.bootstrap_admin
# Do not store BOOTSTRAP_ADMIN_PASSWORD in a committed .env file.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_FIRST_NAME=
BOOTSTRAP_ADMIN_LAST_NAME=

# Optional real hostnames used only by the idempotent seed command. IP addresses
# are intentionally not seeded and remain NULL until operators configure them.
RASPBERRY_1_HOSTNAME=raspberry-1
RASPBERRY_2_HOSTNAME=raspberry-2
RASPBERRY_3_HOSTNAME=raspberry-3
RASPBERRY_4_HOSTNAME=raspberry-4
