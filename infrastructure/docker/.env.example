# Host B address used by the coordinator running on Host A.
# Copy this file to .env and update the address if the local network changes.
NODE_BIO_URL=http://192.168.1.23:8001
NODE_PHY_URL=http://192.168.1.23:8002
NODE_MATH_URL=http://192.168.1.23:8003
NODE_CHEM_URL=http://192.168.1.23:8004
NODE_EARTH_URL=http://192.168.1.23:8005
NODE_AGRO_URL=http://192.168.1.23:8006

# Increase carefully only when measured Wi-Fi latency requires it.
NODE_REQUEST_TIMEOUT_SECONDS=2.0

# Document transfer settings shared by coordinator and storage nodes.
DOCUMENT_TRANSFER_TIMEOUT_SECONDS=30.0
MAX_UPLOAD_SIZE_MB=10
